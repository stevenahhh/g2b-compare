{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G2B Compare Desktop",
  "version": "0.1.3",
  "identifier": "kr.co.g2bcompare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "나라장터 물품 비교",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["../../KakaoTalk_20260804_113126254.png"],
    "resources": ["resources/seed.sqlite3.zip"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOURFMEE4RTVFMEYyMUYKUldRZjh1RGxxT0NkSWhnMEY0QWh2SkpURGZrN25YRFdvazZiemtyN0J6SXVIU3p6VkE4Sms1bEMK",
      "endpoints": [
        "https://github.com/stevenahhh/g2b-compare-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
